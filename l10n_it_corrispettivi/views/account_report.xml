<odoo>
    <report
        id="account_corrispettivi"
        model="account.invoice"
        string="Corrispettivo"
        report_type="qweb-pdf"
        name="l10n_it_corrispettivi.report_corrispettivi"
        file="l10n_it_corrispettivi.report_corrispettivi"
        attachment_use="True"
        attachment="(object.state in ('open','paid')) and ('CORR'+(object.number or '').replace('/','')+'.pdf')"
    />

    <template id="report_corrispettivi">
        <t t-call="report.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_it_corrispettivi.report_corrispettivi_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="report_corrispettivi_document" model="ir.ui.view">
        <field name="name">Corrispettivi</field>
        <field name="model">account.invoice</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="accounting_full.full_report_invoice_document_info"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-if=&quot;o.type == 'out_invoice' and (o.state == 'open' or o.state == 'paid')&quot;]" position="replace">
                <t t-if="o.type == 'out_invoice' and (o.state == 'open' or o.state == 'paid')">
                    Corrispettivo
                </t>
            </xpath>
            <xpath expr="//t[@t-if=&quot;o.type == 'out_invoice' and o.state == 'draft'&quot;]" position="replace">
                <t t-if="o.type == 'out_invoice' and o.state == 'draft'">
                    Draft Corrispettivo
                </t>
            </xpath>
            <xpath expr="//t[@t-if=&quot;o.type == 'out_invoice' and o.state == 'cancel'&quot;]" position="replace">
                <t t-if="o.type == 'out_invoice' and o.state == 'cancel'">
                    Cancelled Corrispettivo
                </t>
            </xpath>
            <xpath expr="//td[@class='col-xs-4'][2]/span[@t-if='o.date_invoice']" position="replace">
                <span t-if="o.date_invoice">
                    <small>Corrispettivo Date</small>
                    <span t-field="o.date_invoice"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
