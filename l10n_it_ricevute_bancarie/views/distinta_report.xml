<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    <template id="distinta_layout">
        <t t-set="company" t-value="res_company" />
        <t t-call="report.external_layout_header" />
        <t t-raw="0" />
    </template>

    <template id="distinta_qweb">

        <t t-call="report.html_container">
            <t t-set="data_report_margin_top" t-value="50"/>
            <t t-set="data_report_header_spacing" t-value="45"/>
            <t t-set="data_report_dpi" t-value="110"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_it_ricevute_bancarie.distinta_layout">
                    <div class="page">

                        <div id="distinta_number" class="row with_bord" style="padding: 2px;">
                            <h4 class="distinta_number" style="margin: 0; padding: 10px 0">
                                <strong>Ricevute Bancarie nr <span t-esc="o.name or 'Bozza'"/> del <span t-field="o.registration_date"/></strong>
                            </h4>
                        </div>

                        <div class="row">
                            <table id="distinta_details" class="table table-bordered table-responsive">
                                <thead>
                                    <tr>
                                        <th>
                                            <p>Invoice Number</p>
                                        </th>
                                        <th>
                                            <p>Invoice Date</p>
                                        </th>
                                        <th>
                                            <p>Customer</p>
                                        </th>
                                        <th>
                                            <p>IBAN</p>
                                        </th>
                                        <th>
                                            <p>Amount</p>
                                        </th>
                                        <th>
                                            <p>Due Date</p>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="tot_amount" t-value="0" />
                                    <tr t-foreach="o.line_ids.sorted(key=lambda b: (b.due_date, b.partner_id.internal_code, b.invoice_number))" t-as="line">
                                        <td>
                                            <p><span t-field="line.invoice_number" /></p>
                                        </td>
                                        <td>
                                            <p><span t-field="line.invoice_date" /></p>
                                        </td>
                                        <td>
                                            <p><span t-field="line.partner_id" /></p>
                                        </td>
                                        <td>
                                            <p><span t-field="line.iban" /></p>
                                        </td>
                                        <td>
                                            <p><span t-field="line.amount" /></p>
                                        </td>
                                        <td>
                                            <p><span t-field="line.due_date" /></p>
                                        </td>
                                        <t t-set="tot_amount" t-value="tot_amount + line.amount" />
                                    </tr>
                                </tbody>
                            </table>
                        </div> <!-- /row -->

                        <div class="row">
                            <div class="col-xs-4 pull-right">
                                <table class="table table-condensed">
                                    <tr class="border-black">
                                        <td><strong>Total</strong></td>
                                        <td class="text-right">
                                            <span t-esc="tot_amount" t-esc-options="{'widget': 'monetary', 'display_currency': 'res_company.currency_id'}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    </data>
</openerp>
