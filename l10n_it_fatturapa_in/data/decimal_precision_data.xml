<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Decimal precision for incoming electronic invoices.
            Higher precision (5 decimals) is needed to correctly match XML values
            and avoid rounding discrepancies during import validation.

            These precision can be adjusted by the user in:
            Settings > Technical > Database Structure > Decimal Accuracy
        -->
        <record forcecreate="True" id="decimal_einvoice_in_quantity" model="decimal.precision">
            <field name="name">E-Invoice IN Quantity</field>
            <field name="digits">5</field>
        </record>

        <record forcecreate="True" id="decimal_einvoice_in_price" model="decimal.precision">
            <field name="name">E-Invoice IN Unit Price</field>
            <field name="digits">5</field>
        </record>
    </data>
</odoo>
