<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- fatturapa kanban -->
        <record id="fatturapa_attachment_out_state_kanban" model="ir.ui.view">
            <field name="name">virtual.fatturapa.attachment.out.state.kanban</field>
            <field name="model">virtual.fatturapa.attachment.out.state</field>
            <field name="arch" type="xml">

                <kanban class="o_kanban_view oe_background_grey o_kanban_dashboard o_cannot_create o_kanban_ungrouped" create="0">

                    <field name="state"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div name="state">
                                <div t-if="record.state.raw_value == 'ready'" class="o_kanban_card_header" style="background-color: #99ccff;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-paper-plane-o fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'sent'" class="o_kanban_card_header" style="background-color: #6699ff;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-paper-plane fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'sender_error'" class="o_kanban_card_header" style="background-color: #ffff99;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-bug fa-2x"/>
                                                <div class="fa fa-level-up fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'recipient_error'" class="o_kanban_card_header" style="background-color: #ffff99;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-bug fa-2x"/>
                                                <div class="fa fa-level-down fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'rejected'" class="o_kanban_card_header" style="background-color: #ff9999;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-times fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'validated'" class="o_kanban_card_header" style="background-color: #99ff99;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div class="fa fa-check-circle-o fa-2x"/>
                                                <div class="fa fa-level-down fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div t-if="record.state.raw_value == 'accepted'" class="o_kanban_card_header" style="background-color: #33cc33;">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary" style="display: flex; align-items: center;">
                                            <div class="col-xs-3">
                                                <div t-if="record.state.raw_value == 'accepted'" class="fa fa-check-circle fa-2x"/>
                                            </div>
                                            <a type="object" name="action_open_view_state" style="font-size: 15px;">
                                                <field name="state"/>
                                            </a>
                                        </div>
                                    </div>
                                </div> <!-- /card_header -->
                                <div class="container o_kanban_card_content o_visible">
                                    <div class="row" style="font-size: 20px;">
                                        <div class="col-xs-9">
                                            <a name="action_open_view_state_current_month" type="object">
                                                Current Month
                                            </a>
                                        </div>
                                        <div class="col-xs-3" style="font-weight: bold; text-align: right;">
                                            <field name="total_fatturapa_out_current_month"/>
                                        </div>
                                    </div>
                                    <div class="row" style="font-size: 20px;">
                                        <div class="col-xs-9">
                                            <a name="action_open_view_state_current_year" type="object">
                                                Current Year
                                            </a>
                                        </div>
                                        <div class="col-xs-3" style="font-weight: bold; text-align: right;">
                                            <field name="total_fatturapa_out_current_year"/>
                                        </div>
                                    </div>
                                </div> <!-- /card_content -->
                            </div>
                        </t>
                    </templates>
                </kanban>

            </field>
        </record>

        <record id="fatturapa_attachment_out_overview_action" model="ir.actions.act_window">
            <field name="name">E-Invoice Overview</field>
            <field name="res_model">virtual.fatturapa.attachment.out.state</field>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="fatturapa_attachment_out_state_kanban"/>
        </record>

        <menuitem action="fatturapa_attachment_out_overview_action"
            parent="accounting_full.menu_account_overview_full"
            name="E-invoice Overview"
            id="fatturapa_attachment_out_overview_menu"
            sequence="2"/>

    </data>
</odoo>