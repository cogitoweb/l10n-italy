<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- fatturapa kanban -->
        <record id="fatturapa_attachment_out_state_kanban" model="ir.ui.view">
            <field name="name">virtual.fatturapa.attachment.out.state.kanban</field>
            <field name="model">virtual.fatturapa.attachment.out.state</field>
            <field name="arch" type="xml">

                <kanban class="o_kanban_view oe_background_grey o_kanban_dashboard o_cannot_create o_kanban_ungrouped" create="0">

                    <field name="state"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div name="state">
                                <div>

                                    <div t-if="record.state.raw_value == 'ready'" class="o_kanban_card_header" style="background-color: #99ccff;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-paper-plane-o fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'sent'" class="o_kanban_card_header" style="background-color: #6699ff;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-paper-plane fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'sender_error'" class="o_kanban_card_header" style="background-color: #ffcc66;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-bug fa-2x"/>
                                                    <div class="fa fa-level-up fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'recipient_error'" class="o_kanban_card_header" style="background-color: #ffcc66;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-bug fa-2x"/>
                                                    <div class="fa fa-level-down fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'rejected'" class="o_kanban_card_header" style="background-color: #ff6666;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-times fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'validated'" class="o_kanban_card_header" style="background-color: #99ff99;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div class="fa fa-check-circle-o fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div t-if="record.state.raw_value == 'accepted'" class="o_kanban_card_header" style="background-color: #33cc33;">
                                        <div class="o_kanban_card_header_title">
                                            <div class="o_primary">
                                                <div class="col-xs-3">
                                                    <div t-if="record.state.raw_value == 'accepted'" class="fa fa-check-circle fa-2x"/>
                                                </div>
                                                <a type="object" name="get_stock_picking_action_picking_type" style="font-size: 15px;">
                                                    <field name="state"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div class="container o_kanban_card_content o_visible">
                                        <div class="row" style="font-size: 20px;">
                                            <div class="col-xs-9">
                                                <a name="get_action_fatturapa_current_month_tree" type="object">
                                                    Current Month
                                                </a>
                                            </div>
                                            <div class="col-xs-3" style="font-weight: bold; text-align: right;">
                                                <field name="total_fatturapa_out_actual_month"/>
                                            </div>
                                        </div>
                                        <div class="row" style="font-size: 20px;">
                                            <div class="col-xs-9">
                                                <a name="get_action_fatturapa_current_year_tree" type="object">
                                                    Current Year
                                                </a>
                                            </div>
                                            <div class="col-xs-3" style="font-weight: bold; text-align: right;">
                                                <field name="total_fatturapa_out"/>
                                            </div>
                                        </div>
                                    </div> <!-- /card_content -->

                                </div>
                            </div>
                        </t>

                    </templates>
                </kanban>

            </field>
        </record>

        <record id="fatturapa_attachment_out_overview_action" model="ir.actions.act_window">
            <field name="name">E-Invoice Overview</field>
            <field name="res_model">virtual.fatturapa.attachment.out.state</field>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="fatturapa_attachment_out_state_kanban"/>
        </record>

        <menuitem action="fatturapa_attachment_out_overview_action"
            parent="l10n_it_fatturapa.menu_fattura_pa_receivables"
            name="E-invoice Overview"
            id="fatturapa_attachment_out_overview_menu"
            sequence="0"/>

        <!-- add action for filter -->
        <record id="l10n_it_fatturapa_pec.action_fatturapa_current_month_tree" model="ir.actions.act_window">
            <field name="name">Fatturapa Attachment Out Current Month</field>
            <field name="res_model">fatturapa.attachment.out</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="domain"></field>
            <field name="context">
                {
                    'search_default_current_month': 1,
                }
            </field>
            <field name="search_view_id" ref="l10n_it_fatturapa_out.view_fatturapa_out_attachment_search"/>
        </record>

        <record id="l10n_it_fatturapa_pec.action_fatturapa_current_year_tree" model="ir.actions.act_window">
            <field name="name">Fatturapa Attachment Out Current Year</field>
            <field name="res_model">fatturapa.attachment.out</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="domain"></field>
            <field name="context">
                {
                    'search_default_current_year': 1,
                }
            </field>
            <field name="search_view_id" ref="l10n_it_fatturapa_out.view_fatturapa_out_attachment_search"/>
        </record>

    </data>
</odoo>