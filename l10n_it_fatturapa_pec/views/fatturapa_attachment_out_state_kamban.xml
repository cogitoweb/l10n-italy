<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- itinerary kanban -->
        <record id="fatturapa_attachment_out_state_kanban" model="ir.ui.view">
            <field name="name">virtual.fatturapa.attachment.out.state.kanban</field>
            <field name="model">virtual.fatturapa.attachment.out.state</field>
            <field name="arch" type="xml">

                <kanban class="oe_background_grey o_kanban_dashboard o_itinerary_kanban" create="0">

                    <field name="state"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div name="state">
                                <div>

                                    <div class="o_kanban_card_header">
                                        <div class="o_kanban_card_header_title">
                                            <div class="col-xs-2">
                                                <div class="fa fa-map-marker fa-2x"/>
                                            </div>
                                            <div>
                                                <field name="state"/>
                                            </div>
                                        </div>
                                    </div> <!-- /card_header -->

                                    <div class="container o_kanban_card_content o_visible">
                                        <div class="row">
                                            <div class="col-xs-5 o_kanban_primary_left">

                                                <button class="btn btn-primary btn-block mb8" type="object" name="action_open_itinerary">
                                                    <span>View details</span>
                                                </button>

                                            </div> <!-- /kanban_primary_left -->

                                            <div class="col-xs-7 o_kanban_primary_right">

                                                <div class="row">
                                                    <div class="col-xs-9">
                                                        <span>Current Month</span>
                                                    </div>
                                                    <div class="col-xs-3" style="text-align:right">
                                                        <field name="total_fatturapa_out"/>
                                                    </div>
                                                </div>

                                            </div> <!-- /kanban_primary_right -->
                                        </div> <!-- /row -->

                                    </div> <!-- /card_content -->

                                </div>
                            </div>
                        </t>

                    </templates>
                </kanban>

            </field>
        </record>


        <record model="ir.ui.view" id="view_fatturapa_out_attachment_tree_2">
            <field name="name">virtual.fatturapa.attachment.out.state.tree</field>
            <field name="model">virtual.fatturapa.attachment.out.state</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="fatturapa_attachment_out_overview_action" model="ir.actions.act_window">
            <field name="name">Electronic Invoice Export Files</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">virtual.fatturapa.attachment.out.state</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_fatturapa_out_attachment_tree_2"/>
        </record>

        <menuitem action="fatturapa_attachment_out_overview_action"
            parent="l10n_it_fatturapa.menu_fattura_pa_receivables"
            name="E-invoice Overview"
            id="fatturapa_attachment_out_overview_menu"
            sequence="0"/>
    </data>
</odoo>